# Local development only. Never reuse these credentials in Azure.
POSTGRES_PASSWORD=crmf_local_only
MARIADB_ROOT_PASSWORD=crmf_local_root_only
KEYCLOAK_ADMIN_PASSWORD=crmf_local_admin_only

# Own auth is opt-in via: python scripts/tasks.py auth-dev
# Production (host/container environment, not this dev Compose):
# AUTH_ENABLED=true
# AUTH_DATABASE_URL=<isolated crmf_auth connection>
# AUTH_KEYVAULT_SECRET_URL=https://<vault>.vault.azure.net/secrets/<name>/<32-hex-version>
# AUTH_TENANT_ORIGIN=https://dash.<domain>
# AUTH_PLATFORM_ORIGIN=https://hq.<domain>
# AUTH_TRUSTED_PROXIES=<explicit ingress CIDRs; never 0.0.0.0/0>
# AZURE_CLIENT_ID=<optional user-assigned managed identity client ID>
# APP_ENV defaults to production. AUTH_KEY_FILE is forbidden outside development.
